@startuml 04-seq-refund-failed
title Sequence - Refund a Failed Payment (US-23, US-27)
autonumber
skinparam shadowing false

participant "Trigger\n(biller refusal /\nre-query / reconciliation)" as T
participant "PaymentService" as PS
participant "Payment\n(State + History)" as P
participant "WalletService" as W
database "Ledger" as L
participant "AuditLog" as AU
participant "NotificationService" as N
actor Customer as C

T -> PS : request refund evaluation(paymentId, evidence)

group Refund transaction
  PS -> P : lock payment row and read current state
  alt already Refunded
    PS -> AU : log duplicate refund trigger
    PS -> PS : commit without ledger changes
    PS --> T : already refunded
  else Unknown without definitive failure proof
    note over PS, P : Payment stays Unknown.\nFunds stay HELD.
    PS -> PS : end transaction without changes
    PS --> T : no refund
  else Failed, or SentToBiller with biller refusal, or Unknown with definitive failure proof
    opt state is not already Failed
      PS -> P : transition to Failed (write history)
    end
    PS -> W : verify and release active hold within transaction
    W -> L : lock wallet and check unreleased hold
    alt active hold exists
      W -> L : HELD -352.50 (RELEASE)
      W -> L : AVAILABLE +352.50 (RELEASE)
      W --> PS : release entries staged
      PS -> P : Failed -> Refunded (write history, Q-08)
      PS -> AU : record refund audit (actor, reason, time)
      PS -> PS : commit release, state change and audit together
      note right of PS : No fee or agent commission is earned.
      PS --> T : refund completed
      PS ->> N : PaymentFailed(reason, refund completed)
      N -> C : SMS + push with clear reason
      loop up to 3 retries if delivery fails
        N -> C : retry failed delivery
      end
      opt delivery still failed after 4 attempts
        N -> N : mark undelivered
      end
    else no active hold and payment is not Refunded
      W --> PS : inconsistent hold state
      PS -> PS : roll back refund transaction
      PS -> AU : log inconsistency for review
      PS --> T : no funds released
    end
  else current state does not permit refund
    PS -> AU : log refused refund attempt
    PS -> PS : commit without ledger changes
    PS --> T : refund refused
  end
end

note over P : Completed, Rejected and Refunded are final (US-17).
@enduml
